{
  "expo": {
    "name": "Conta FT Móvil",
    "slug": "AppMobilFacturacion",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C3AED"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.innovaciondigital.contamovil",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7C3AED"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Necesitamos la cámara para escanear el código QR de tu empresa"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b9c05f22-b3c4-4469-84b3-c09fa2368859"
      }
    },
    "owner": "elmejorb"
  }
}
